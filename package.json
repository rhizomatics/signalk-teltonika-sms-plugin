{
  "name": "@rhizomatics/signalk-teltonika-sms-plugin",
  "version": "0.2.2",
  "description": "Deliver SignalK notifications as SMS via a Teltonika router's RutOS API, e.g. an anchor watch alert.",
  "keywords": [
    "RutOS",
    "anchor-alarm",
    "notifications",
    "signalk",
    "signalk-category-notifications",
    "signalk-node-server-plugin",
    "sms",
    "teltonika"
  ],
  "homepage": "https://github.com/rhizomatics/signalk-teltonika-sms-plugin",
  "bugs": {
    "url": "https://github.com/rhizomatics/signalk-teltonika-sms-plugin/issues"
  },
  "license": "Apache-2.0",
  "author": "jey burrows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhizomatics/signalk-teltonika-sms-plugin.git"
  },
  "bin": {
    "teltonika-sms-cli": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "cli": "tsx src/cli/index.ts",
    "test": "node scripts/run-tests.js",
    "coverage": "node scripts/run-tests.js --coverage",
    "prepublishOnly": "npm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.28.0",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "signalk": {
    "displayName": "Teltonika SMS Notifications",
    "appIcon": "docs/assets/icons/icon.svg",
    "screenshots": []
  }
}
